# Database URLs (Supabase)
DATABASE_URL="postgresql://user:password@host:port/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:port/postgres"

# Supabase API keys
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Auth Secret
JWT_SECRET="generate-a-secure-random-string-for-production"

# Google OAuth (used for Calendar integration only)
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Google Drive — Service Account (used for resume uploads/downloads)
# Option A (recommended): paste the ENTIRE contents of your service account JSON key file as one line
GOOGLE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}'

# Option B: split into two individual vars (alternative to Option A)
# GOOGLE_CLIENT_EMAIL="your-service-account@your-project.iam.gserviceaccount.com"
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# The Google Drive folder ID where resumes will be uploaded
# Share this folder with your service account email as an Editor
GOOGLE_DRIVE_FOLDER_ID="your-folder-id"

# AI Service Keys
GEMINI_API_KEY="your-gemini-api-key"

# ML Microservice URL
ML_SERVICE_URL="http://localhost:8000"

# SMTP (Email)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="your-email@example.com"
SMTP_PASS="your-app-password"
FROM_EMAIL="your-email@example.com"
